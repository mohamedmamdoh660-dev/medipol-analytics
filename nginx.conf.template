# Serves the built SPA at the root of its own (sub)domain, listening on port 80.
# The container is published on host port 8090; the Cloudflare Tunnel points
# analytics-automation.medipol.edu.tr → http://localhost:8090.
server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  # Health check for the tunnel
  location = /health {
    default_type text/plain;
    return 200 'ok';
  }

  # Hashed build assets — safe to cache hard
  location /assets/ {
    try_files $uri =404;
    expires 30d;
    add_header Cache-Control "public, immutable";
  }

  # App + public files, with SPA fallback
  location / {
    try_files $uri $uri/ /index.html;
  }
}
