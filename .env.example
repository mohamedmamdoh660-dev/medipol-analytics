# Copy to .env (used by docker-compose) or .env.local (used by `npm run dev`).
# Only PUBLIC values belong here. NEVER put the service_role key in the frontend.

# Sub-path the app is served under (must match your Cloudflare route).
# Change here and both the Vite build and nginx follow it — never hard-coded.
BASE_PATH=/analytics

# Host port to expose. App will then be reachable at:
#   http://localhost:${PORT}${BASE_PATH}   e.g. http://localhost:8098/analytics
PORT=8098

# --- Supabase (self-hosted). The anon key is a PUBLIC client key (safe). ---
VITE_SUPABASE_URL=https://supabase-automation.medipol.edu.tr
VITE_SUPABASE_ANON_KEY=your-anon-key

# --- Ollama endpoint powering the AI features (must allow browser CORS). ---
VITE_OLLAMA_URL=https://your-ollama-endpoint
VITE_OLLAMA_MODEL=qwen2.5:14b

# NOTE: this app talks to Supabase + Ollama directly from the browser.
# There is NO separate backend and NO direct PostgreSQL connection,
# so no DB_HOST / DB_USER / DB_PASSWORD variables are needed.
