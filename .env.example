# Copy to .env (docker-compose) or .env.local (`npm run dev`).
# Only PUBLIC values belong here. NEVER put the service_role key in the frontend.

# Base path. "/" = served at the root of its own subdomain (current setup:
# analytics-automation.medipol.edu.tr). Set to /analytics only for a sub-path.
BASE_PATH=/

# Host port to expose. The Cloudflare tunnel points the subdomain here.
PORT=8090

# --- Supabase (self-hosted). The anon key is a PUBLIC client key (safe). ---
VITE_SUPABASE_URL=https://supabase-automation.medipol.edu.tr
VITE_SUPABASE_ANON_KEY=your-anon-key

# --- Ollama endpoint powering the AI features (must allow browser CORS). ---
VITE_OLLAMA_URL=https://ollama-automation.medipol.edu.tr
VITE_OLLAMA_MODEL=qwen2.5:14b

# NOTE: this app talks to Supabase + Ollama directly from the browser.
# There is NO separate backend and NO direct PostgreSQL connection.
