# Copy to .env (docker-compose) or .env.local (`npm run dev`).

# Base path. "/" = served at the root of its own subdomain
# (analytics-automation.medipol.edu.tr). Set to /analytics for a sub-path.
BASE_PATH=/

# Host port exposed. The Cloudflare tunnel points the subdomain here.
PORT=8090

# --- Public client config (safe to expose; baked into the frontend) ---------
VITE_SUPABASE_URL=https://supabase-automation.medipol.edu.tr
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_OLLAMA_URL=https://ollama-automation.medipol.edu.tr
VITE_OLLAMA_MODEL=qwen2.5:14b

# --- SERVER-SIDE ONLY — powers the admin API (create user / password / block).
# NEVER prefix with VITE_ and NEVER commit the real value. Set it in Coolify.
SUPABASE_SERVICE_ROLE=your-service-role-key
